{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-inquiry-origins.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "node scripts/serve-built-site.mjs",
    "check-locales": "node scripts/check-locales.mjs",
    "test:inquiry": "node --test scripts/inquiry-regression.mjs",
    "test:browser": "node scripts/browser-regression.mjs",
    "test:csp": "node scripts/csp-regression.mjs",
    "test:seo": "node scripts/seo-regression.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.6.6",
    "resend": "^6.32.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/locales/*.json": [
      "node scripts/sort-locales.mjs"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/router-devtools": "^1.167.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "packageManager": "pnpm@11.25.0"
}
