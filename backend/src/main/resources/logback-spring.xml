<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProfile name="!prod">
        <!-- Local/Dev: colorized console output -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%cyan(%d{HH:mm:ss}) %highlight(%-5level) [%yellow(%X{traceId})] %magenta(%logger{30}) - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.hissus" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod">
        <!-- Production: structured JSON output -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>{"time":"%d{ISO8601}","level":"%level","traceId":"%X{traceId}","logger":"%logger{36}","msg":"%message"}%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.hissus" level="INFO"/>
    </springProfile>
</configuration>
